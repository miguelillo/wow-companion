{
  "$id": "https://wowcompanion/contracts/v1/step.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(prof|lvl)-[a-z0-9]+(?:-[a-z0-9]+)*-\\d{3}$"
    },
    "from": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "to": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "materials": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "itemId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "item",
          "quantity"
        ]
      }
    },
    "note": {
      "type": "string"
    },
    "place": {
      "type": "object",
      "properties": {
        "zone": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "zone",
        "x",
        "y"
      ]
    }
  },
  "required": [
    "id",
    "from",
    "to",
    "action"
  ]
}
