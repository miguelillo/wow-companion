# Blizzard OAuth client credentials, from https://develop.battle.net/access/clients
# Used by `pnpm run data:sync` (build time) and by the API (realm status, login).
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Game Data namespace and region.
# There is no published namespace for World of Warcraft: Forever yet. Until Blizzard
# documents one, point this at a Classic namespace to exercise the pipeline and see
# README "Blizzard game data" before assuming the output is Forever data.
BLIZZARD_NAMESPACE=static-classic1x-eu
BLIZZARD_REGION=eu
BLIZZARD_LOCALE=es_ES

# Public base URL of the site, used for canonicals, sitemap and Open Graph.
PUBLIC_SITE_URL=http://localhost:4321

# Base URL the browser uses to reach our own API. Empty means same origin via the proxy.
PUBLIC_API_URL=http://localhost:5080

# Postgres, consumed by docker-compose and the API.
POSTGRES_DB=wowcompanion
POSTGRES_USER=wowcompanion
POSTGRES_PASSWORD=change-me-in-production
