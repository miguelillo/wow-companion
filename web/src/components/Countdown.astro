---
import { daysUntilLaunch, gameDates } from '../data/game-dates';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const days = daysUntilLaunch();

function message(remaining: number): string {
  if (remaining > 1) return t('home.countdown.remaining', { days: remaining });
  if (remaining === 1) return t('home.countdown.tomorrow');
  if (remaining === 0) return t('home.countdown.today');
  return t('home.countdown.launched');
}
---

<section class="panel" aria-labelledby="countdown-title">
  <h2 id="countdown-title" class="h">
    {t('home.countdown.title')}
  </h2>
  <p
    class="count"
    data-countdown
    data-launch={gameDates.launch.toISOString()}
    data-remaining={t('home.countdown.remaining', { days: '{days}' })}
    data-tomorrow={t('home.countdown.tomorrow')}
    data-today={t('home.countdown.today')}
    data-launched={t('home.countdown.launched')}
  >
    {message(days)}
  </p>
  <p class="small muted">{t('home.countdown.beta')}</p>
</section>

<style>
  .h {
    font-size: var(--step-1);
  }

  .count {
    font-family: var(--font-display);
    font-size: var(--step-2);
    margin-block: var(--space-2);
  }
</style>

<script>
  // The day count is baked in at build time; this keeps it right between deploys.
  const node = document.querySelector<HTMLElement>('[data-countdown]');
  const launchIso = node?.dataset['launch'];

  if (node && launchIso) {
    const launch = new Date(launchIso);
    const msPerDay = 86_400_000;
    const now = new Date();
    const today = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate());
    const target = Date.UTC(launch.getUTCFullYear(), launch.getUTCMonth(), launch.getUTCDate());
    const days = Math.round((target - today) / msPerDay);

    const text =
      days > 1
        ? (node.dataset['remaining'] ?? '').replace('{days}', String(days))
        : days === 1
          ? node.dataset['tomorrow']
          : days === 0
            ? node.dataset['today']
            : node.dataset['launched'];

    if (text) node.textContent = text;
  }
</script>
