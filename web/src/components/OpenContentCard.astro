---
import BetaBadge from './BetaBadge.astro';
import { contentCalendar, contentStatus } from '../data/content-calendar';
import { formatDate, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const now = new Date();
const entries = contentCalendar.map((entry) => ({ entry, status: contentStatus(entry, now) }));
---

<section class="panel" aria-labelledby="open-content-title">
  <h2 id="open-content-title">{t('home.open.title')}</h2>
  <ul>
    {entries.map(({ entry, status }) => (
      <li id={entry.key}>
        <div class="row">
          <span class={status === 'open' ? 'badge badge-open' : 'badge'}>
            {status === 'open' ? t('home.open.available') : t('home.open.upcoming')}
          </span>
          <strong>{entry.name[locale]}</strong>
          <BetaBadge locale={locale} confirmed={entry.confirmed} />
        </div>
        <p class="small muted">{entry.detail[locale]}</p>
        <p class="small muted">
          {entry.opensAt === null ? (
            t('home.open.unknownDate')
          ) : (
            <time datetime={entry.opensAt.toISOString()}>{formatDate(entry.opensAt, locale)}</time>
          )}
        </p>
      </li>
    ))}
  </ul>
</section>

<style>
  h2 {
    font-size: var(--step-1);
    margin-block-end: var(--space-3);
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li + li {
    margin-block-start: var(--space-3);
    padding-block-start: var(--space-3);
    border-block-start: 1px solid var(--line);
  }

  .date {
    color: var(--muted);
    opacity: 0.85;
  }

  p + p {
    margin-block-start: var(--space-1);
  }

  .row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
</style>
