---
import type { CollectionEntry } from 'astro:content';
import { formatDate, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'patches'>;
  headingLevel?: 'h2' | 'h3';
}

const { locale, entry, headingLevel = 'h3' } = Astro.props;
const t = useTranslations(locale);
const Heading = headingLevel;
const { title, date, summary, source, sourceLabel, slug } = entry.data;
---

<article class="panel" id={slug}>
  <p class="small muted">
    <time datetime={date.toISOString()}>{formatDate(date, locale)}</time>
  </p>
  <Heading>{title}</Heading>
  <p>{summary}</p>
  <p class="small">
    <a href={source} rel="nofollow noopener">
      {t('home.news.source')}: {sourceLabel}
    </a>
  </p>
</article>

<style>
  article > * + * {
    margin-block-start: var(--space-2);
  }

  article p:not(.small) {
    max-width: var(--measure);
  }
</style>
