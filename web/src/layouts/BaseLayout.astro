---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { localeTags, locales, useTranslations, type Locale } from '../i18n';
import { absoluteUrl } from '../lib/seo';

interface Props {
  locale: Locale;
  /** Written per page, never templated. */
  title: string;
  /** Written per page, never templated. */
  description: string;
  /** Path of this same page in each language; omit a language when it does not exist yet. */
  alternates?: Partial<Record<Locale, string>>;
  jsonLd?: readonly unknown[];
  ogType?: 'website' | 'article';
  /** Sections that are not written yet are kept out of the index and out of the sitemap. */
  noindex?: boolean;
}

const {
  locale,
  title,
  description,
  alternates = {},
  jsonLd = [],
  ogType = 'website',
  noindex = false,
} = Astro.props;

const canonical = absoluteUrl(Astro.url.pathname, Astro.site);
const t = useTranslations(locale);
const defaultAlternate = alternates['es'];
const rssPath = locale === 'es' ? '/parches/rss.xml' : '/en/patches/rss.xml';
---

<!doctype html>
<html lang={localeTags[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {locales.map((alternateLocale) => {
      const path = alternates[alternateLocale];
      return path === undefined ? null : (
        <link
          rel="alternate"
          hreflang={localeTags[alternateLocale]}
          href={absoluteUrl(path, Astro.site)}
        />
      );
    })}
    {defaultAlternate !== undefined && (
      <link rel="alternate" hreflang="x-default" href={absoluteUrl(defaultAlternate, Astro.site)} />
    )}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_GB'} />
    <meta property="og:image" content={absoluteUrl('/og-default.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('site.tagline')} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/logo-mark-compact.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={t('patches.title')} href={rssPath} />
    <meta name="color-scheme" content="light dark" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Marcellus&family=Karla:wght@400;600&display=swap"
    />

    {jsonLd.map((schema) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)}></script>
    ))}

    <script is:inline>
      // Applies the saved theme before first paint so the page never flashes the wrong one.
      try {
        const stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.dataset.theme = stored;
        }
      } catch {
        /* Storage can be blocked. The system preference still applies. */
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t('a11y.skipToContent')}
    </a>
    <Header locale={locale} alternates={alternates} />
    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <Footer locale={locale} />
  </body>
</html>
