# Optional libraries, deliberately NOT listed here. A .toc line pointing at a file that
# is not shipped is a load error, and we ship no third-party code. The addon asks for
# them at runtime instead (LibStub with the silent flag), so it runs fine without any:
# no LibDeflate means a longer transfer string, no HereBeDragons means no map pins.
#
# To enable them, either install LibDeflate and HereBeDragons-2.0 as standalone addons,
# or drop the files under Libs/ and uncomment these four lines:
# Libs\LibStub\LibStub.lua
# Libs\LibDeflate\LibDeflate.lua
# Libs\HereBeDragons\HereBeDragons-2.0.lua
# Libs\HereBeDragons\HereBeDragons-Pins-2.0.lua

Json.lua
Codec.lua
Progress.lua
Route.lua
Core.lua
UI.lua
Map.lua
Leveling.lua
Profession.lua

# Generated by `pnpm run addon:export`. Never edited by hand.
Guides\en.lua
Guides\es.lua
