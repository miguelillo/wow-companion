# One origin in front of both services: the browser calls /api/... on the same host,
# so the static site needs no CORS and no absolute API URL baked into the build.
{$SITE_ADDRESS:http://localhost:8080} {
	encode gzip zstd

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:80
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
